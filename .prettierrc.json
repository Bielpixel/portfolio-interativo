{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 90,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "css",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.svg",
      "options": { "parser": "html" }
    }
  ]
}
